    "chafa": {
      "optional": true,
      "role": "ascii-image-fallback",
      "capability": "Render images as Unicode/ASCII blocks when the terminal graphics protocol cannot display inline images.",
      "overlap": "It is a fallback for terminal display, not a replacement for ffmpeg, pdftoppm or resvg. It can be unnecessary when native Sixel/Kitty graphics works.",
