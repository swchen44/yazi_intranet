# Keep the upstream Yazi source checkout local; the public packaging project
# contains only docs, packaging code and selected dist artifacts.
/yazi/
/packaging/source-runtime/
/dist/yazi-intranet-*
/dist/official/*.tar.gz
/dist/official/*.zip
/dist/plugin-full/*.tar.gz
/dist/plugin-full/*.zip
/dist/plugin-full/glow-tui/*.tar.gz
/dist/plugin-full/glow-tui/*.zip

# Local build/test output.
__pycache__/
*.py[cod]
.DS_Store
.vscode/
