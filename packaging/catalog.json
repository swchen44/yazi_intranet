  "helper_matrix": {
    "file": {
      "optional": false,
      "role": "required",
      "capability": "Detect MIME/type and provide Yazi's file-type fallback.",
      "overlap": "No equivalent optional helper; Yazi requires file(1).",
      "dependencies": {
        "linux": ["package-local libmagic and magic.mgc", "host glibc baseline"],
        "windows": ["package-local PortableGit file.exe DLLs and magic.mgc"]
      },
      "linux": {
        "bundle_status": "host-vendor",
        "runtime_test": "passed",
        "test_command": "file --version; file fixture.json"
      },
      "windows": {
        "bundle_status": "included",
        "runtime_test": "pending",
        "test_command": "file.exe --version; file.exe fixture.json"
      }
    },
    "7zz": {
      "optional": true,
      "role": "archive-preview",
      "capability": "List and extract 7z/zip/tar and other archive formats used by Yazi preview/actions.",
      "overlap": "Not replaced by fd, rg or fzf; those search/select files but do not inspect archives.",
      "dependencies": {
        "linux": ["package-local 7zz"],
        "windows": ["package-local 7zz.exe, 7za.dll and 7zxa.dll"]
      },
      "linux": {
        "bundle_status": "included",
        "runtime_test": "passed",
        "test_command": "7zz i"
      },
      "windows": {
        "bundle_status": "included",
        "runtime_test": "pending",
        "test_command": "7zz.exe i"
      }
    },
    "ffmpeg": {
      "optional": true,
      "role": "video-preview",
      "capability": "Create video thumbnails and inspect video metadata; ffprobe is delivered from the same build.",
      "overlap": "Not replaced by ImageMagick; ImageMagick handles images/fonts, while FFmpeg handles video containers/codecs.",
      "dependencies": {
        "linux": ["package-local ffmpeg and ffprobe", "terminal graphics protocol for visible thumbnails"],
        "windows": ["package-local ffmpeg.exe and ffprobe.exe", "terminal graphics protocol for visible thumbnails"]
      },
      "linux": {
        "bundle_status": "included",
        "runtime_test": "passed",
        "test_command": "ffmpeg -version; ffprobe -version"
      },
      "windows": {
        "bundle_status": "included",
        "runtime_test": "pending",
        "test_command": "ffmpeg.exe -version; ffprobe.exe -version"
      }
    },
    "jq": {
      "optional": true,
      "role": "json-preview",
      "capability": "Pretty-print JSON preview and transformations.",
      "overlap": "Yazi has an internal JSON/code fallback, so jq improves the preview but is not a startup requirement.",
      "dependencies": {
        "linux": ["package-local jq"],
        "windows": ["package-local jq.exe"]
      },
      "linux": {"bundle_status": "included", "runtime_test": "passed", "test_command": "jq . fixture.json"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "jq.exe . fixture.json"}
    },
    "pdftoppm": {
      "optional": true,
      "role": "pdf-preview",
      "component": "Poppler",
      "capability": "Render PDF pages into images for Yazi PDF preview; this bundle currently exposes pdftoppm, not every Poppler utility.",
      "overlap": "ImageMagick can sometimes rasterize PDFs, but it is not a drop-in replacement for the Poppler path Yazi documents.",
      "dependencies": {
        "linux": ["audited Poppler/pdftoppm build still required", "terminal graphics protocol for visible pages"],
        "windows": ["package-local Poppler DLLs and pdftoppm.exe", "terminal graphics protocol for visible pages"]
      },
      "linux": {"bundle_status": "pending", "runtime_test": "pending", "test_command": "pdftoppm -h"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "pdftoppm.exe -h"}
    },
    "resvg": {
      "optional": true,
      "role": "svg-preview",
      "capability": "Render SVG previews.",
      "overlap": "ImageMagick can convert some SVG files, but resvg is the focused SVG renderer used by Yazi's documented optional path.",
      "dependencies": {
        "linux": ["package-local resvg"],
        "windows": ["No upstream Windows CLI asset in the pinned release"]
      },
      "linux": {"bundle_status": "included", "runtime_test": "passed", "test_command": "resvg --version"},
      "windows": {"bundle_status": "unavailable", "runtime_test": "not-applicable", "test_command": "Not available from upstream release"}
    },
    "chafa": {
      "optional": true,
      "role": "ascii-image-fallback",
      "capability": "Render images as Unicode/ASCII blocks when the terminal graphics protocol cannot display inline images.",
      "overlap": "It is a fallback for terminal display, not a replacement for ffmpeg, pdftoppm or resvg. It can be unnecessary when native Sixel/Kitty graphics works.",
      "dependencies": {
        "linux": ["official statically linked GNU/Linux binary; glibc >= 2.17 baseline per upstream", "no Sixel/Kitty protocol required for ASCII output"],
        "windows": ["official Windows x86_64 standalone binary", "Windows 10 or later per upstream"]
      },
      "linux": {"bundle_status": "included", "runtime_test": "passed", "test_command": "chafa --version; chafa fixture.png"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "chafa.exe --version; chafa.exe fixture.png"}
    },
    "rg": {
      "optional": true,
      "role": "content-search",
      "capability": "Search file contents from Yazi workflows.",
      "overlap": "fd searches names; rg searches contents. They complement each other rather than substitute each other.",
      "dependencies": {"linux": ["package-local rg"], "windows": ["package-local rg.exe"]},
      "linux": {"bundle_status": "included", "runtime_test": "passed", "test_command": "rg --version"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "rg.exe --version"}
    },
    "fd": {
      "optional": true,
      "role": "file-search",
      "capability": "Fast filename/path search.",
      "overlap": "rg searches contents; fd searches paths. Both are useful together, but neither requires the other.",
      "dependencies": {"linux": ["package-local fd"], "windows": ["package-local fd.exe"]},
      "linux": {"bundle_status": "included", "runtime_test": "passed", "test_command": "fd --version"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "fd.exe --version"}
    },
    "fzf": {
      "optional": true,
      "role": "interactive-selection",
      "capability": "Interactive filtering/selection for file navigation workflows.",
      "overlap": "Not a replacement for fd or rg; it is the interactive selector often used with their output.",
      "dependencies": {"linux": ["package-local fzf"], "windows": ["package-local fzf.exe"]},
      "linux": {"bundle_status": "included", "runtime_test": "passed", "test_command": "fzf --version"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "fzf.exe --version"}
    },
    "zoxide": {
      "optional": true,
      "role": "directory-navigation",
      "capability": "Jump to historical/frequently used directories from shell/Yazi workflows.",
      "overlap": "Not required for Yazi browsing; documented Yazi integration requires fzf as well.",
      "dependencies": {"linux": ["package-local zoxide", "fzf for the documented Yazi integration"], "windows": ["package-local zoxide.exe", "fzf.exe for the documented Yazi integration"]},
      "linux": {"bundle_status": "included", "runtime_test": "passed", "test_command": "zoxide --version"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "zoxide.exe --version"}
    },
    "magick": {
      "optional": true,
      "role": "image-format-preview",
      "capability": "Font, HEIC and JPEG XL/image conversion support.",
      "overlap": "Some image conversion overlaps with resvg/chafa, but ImageMagick covers broader formats and is not a video/PDF preview substitute.",
      "dependencies": {
        "linux": ["official AppImage currently fails on surfer because libharfbuzz.so.0 is absent; not bundled"],
        "windows": ["package-local ImageMagick portable Q8 runtime"]
      },
      "linux": {"bundle_status": "pending", "runtime_test": "pending", "test_command": "magick -version"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "magick.exe -version"}
    },
    "glow": {
      "optional": true,
      "role": "markdown-viewer",
      "capability": "Render Markdown as formatted terminal output; it is an extra user tool, not a Yazi startup dependency.",
      "overlap": "bat also displays Markdown, but bat emphasizes source/syntax highlighting while glow renders the document.",
      "dependencies": {"linux": ["package-local glow"], "windows": ["package-local glow.exe"]},
      "linux": {"bundle_status": "included", "runtime_test": "passed", "test_command": "glow --version"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "glow.exe --version"}
    },
    "bat": {
      "optional": true,
      "role": "syntax-viewer",
      "capability": "Syntax-highlighted text/Markdown viewer; it is an extra user tool, not a Yazi startup dependency.",
      "overlap": "glow renders Markdown; bat shows source with syntax highlighting. They are complementary rather than identical.",
      "dependencies": {"linux": ["package-local bat musl binary"], "windows": ["package-local bat.exe", "Windows VC runtime must be verified on acceptance host"]},
      "linux": {"bundle_status": "included", "runtime_test": "passed", "test_command": "bat --version; bat --paging=never README.md"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "bat.exe --version; bat.exe --paging=never README.md"}
    },
    "duckdb": {
      "optional": true,
      "role": "tabular-preview",
      "capability": "Render CSV, TSV and Parquet through duckdb.yazi.",
      "overlap": "Yazi can still show raw CSV/TSV text without this helper; Parquet tabular preview needs DuckDB.",
      "dependencies": {"linux": ["package-local DuckDB CLI", "host glibc baseline"], "windows": ["package-local DuckDB CLI", "Microsoft Visual C++ Redistributable may be required"]},
      "linux": {"bundle_status": "included", "runtime_test": "pending", "test_command": "duckdb --version"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "duckdb.exe --version"}
    },
    "lazygit": {
      "optional": true,
      "role": "git-tui",
      "capability": "Open Git repositories through the G-i shortcut.",
      "overlap": "Git status fetcher works without lazygit; lazygit provides an interactive UI.",
      "dependencies": {"linux": ["package-local lazygit", "host git"], "windows": ["package-local lazygit.exe", "host git.exe"]},
      "linux": {"bundle_status": "included", "runtime_test": "pending", "test_command": "lazygit --version"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "lazygit.exe --version"}
    },
    "tree": {
      "optional": true,
      "role": "directory-tree",
      "capability": "GNU-style directory tree listing using the MSYS path conventions.",
      "overlap": "Windows also has tree.exe with different options; this bundle puts the MSYS2 binary first on PATH.",
      "dependencies": {"linux": ["host tree optional, not bundled"], "windows": ["package-local tree.exe", "PortableGit msys-2.0.dll compatibility pending Windows test"]},
      "linux": {"bundle_status": "not-in-scope", "runtime_test": "not-applicable", "test_command": "not bundled"},
      "windows": {"bundle_status": "included", "runtime_test": "pending", "test_command": "tree.exe --version; tree.exe -a -L 2 fixture"}
    }
  },
